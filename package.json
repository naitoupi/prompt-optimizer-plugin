{
  "name": "prompt-optimizer-plugin",
  "version": "0.10.1",
  "private": true,
  "description": "DSH installable bundle (dsh.bundle + dsh.client): ✨ optimize the composer draft with the current model; Settings tab controls on/off, generation params, and an editable system prompt with reset-to-default (v10).",
  "type": "module",
  "main": "src/host.js",
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
