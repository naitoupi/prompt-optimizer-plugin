{
  "name": "prompt-optimizer-plugin",
  "version": "0.12.5",
  "private": true,
  "description": "DeepSeek Harness (DSH) plugin: a ✨ button next to the composer that rewrites your draft into a clearer, more specific prompt using your current model.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "prompt-optimizer",
    "dsh-bundle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naitoupi/prompt-optimizer-plugin.git"
  },
  "homepage": "https://github.com/naitoupi/prompt-optimizer-plugin#readme",
  "bugs": {
    "url": "https://github.com/naitoupi/prompt-optimizer-plugin/issues"
  },
  "type": "module",
  "main": "src/host.js",
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
